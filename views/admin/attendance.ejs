<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2><i class="bi bi-calendar-check-fill me-2 text-success"></i>Attendance</h2>
    <p class="text-muted mb-0">Student: <strong><%= student.name %></strong> &mdash; Roll: <span class="badge bg-secondary"><%= student.rollNumber %></span></p>
  </div>
  <a href="/admin/students/<%= student._id %>" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Back
  </a>
</div>

<% if (success) { %>
  <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-1"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-1"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>

<div class="card shadow-sm mb-4">
  <div class="card-header bg-light fw-semibold"><i class="bi bi-table me-2"></i>Attendance Records (<%= records.length %>)</div>
  <div class="card-body p-0">
    <% if (records.length === 0) { %>
      <div class="text-center py-4 text-muted"><i class="bi bi-inbox fs-2"></i><p class="mt-2">No attendance records yet.</p></div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>Date</th><th>Status</th><th>Remarks</th></tr>
          </thead>
          <tbody>
            <% records.forEach(r => { %>
              <tr>
                <td><%= new Date(r.date).toLocaleDateString() %></td>
                <td>
                  <% if (r.status === 'present') { %>
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Present</span>
                  <% } else if (r.status === 'absent') { %>
                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Absent</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Late</span>
                  <% } %>
                </td>
                <td><%= r.remarks || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header bg-success text-white fw-semibold"><i class="bi bi-plus-circle me-2"></i>Mark Attendance</div>
  <div class="card-body">
    <form action="/admin/students/<%= student._id %>/attendance" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Date <span class="text-danger">*</span></label>
          <input type="date" class="form-control" name="date" required
                 value="<%= new Date().toISOString().split('T')[0] %>" />
        </div>
        <div class="col-md-3">
          <label class="form-label">Status <span class="text-danger">*</span></label>
          <select class="form-select" name="status" required>
            <option value="present">Present</option>
            <option value="absent">Absent</option>
            <option value="late">Late</option>
          </select>
        </div>
        <div class="col-md-5">
          <label class="form-label">Remarks</label>
          <input type="text" class="form-control" name="remarks" placeholder="Optional remarks..." />
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Mark Attendance</button>
        </div>
      </div>
    </form>
  </div>
</div>
