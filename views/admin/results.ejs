<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Results</h2>
    <p class="text-muted mb-0">Student: <strong><%= student.name %></strong> &mdash; Roll: <span class="badge bg-secondary"><%= student.rollNumber %></span></p>
  </div>
  <a href="/admin/students/<%= student._id %>" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Back
  </a>
</div>

<% if (success) { %>
  <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-1"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-1"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>

<div class="card shadow-sm mb-4">
  <div class="card-header bg-light fw-semibold"><i class="bi bi-list-ol me-2"></i>Result Records (<%= results.length %>)</div>
  <div class="card-body p-0">
    <% if (results.length === 0) { %>
      <div class="text-center py-4 text-muted"><i class="bi bi-inbox fs-2"></i><p class="mt-2">No results recorded yet.</p></div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>Subject</th><th>Marks</th><th>Grade</th><th>Exam Type</th><th>Academic Year</th><th>Date</th><th class="text-center">Action</th></tr>
          </thead>
          <tbody>
            <% results.forEach(r => { %>
              <tr>
                <td class="fw-semibold"><%= r.subject %></td>
                <td><%= r.marks %> / <%= r.totalMarks %></td>
                <td><span class="badge bg-primary"><%= r.grade %></span></td>
                <td><span class="badge bg-info text-dark"><%= r.examType %></span></td>
                <td><%= r.academicYear || '-' %></td>
                <td><%= new Date(r.createdAt).toLocaleDateString() %></td>
                <td class="text-center">
                  <form action="/admin/results/<%= r._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this result?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header bg-primary text-white fw-semibold"><i class="bi bi-plus-circle me-2"></i>Add New Result</div>
  <div class="card-body">
    <form action="/admin/students/<%= student._id %>/results" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Subject <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="subject" required />
        </div>
        <div class="col-md-2">
          <label class="form-label">Marks <span class="text-danger">*</span></label>
          <input type="number" class="form-control" name="marks" min="0" required />
        </div>
        <div class="col-md-2">
          <label class="form-label">Total Marks</label>
          <input type="number" class="form-control" name="totalMarks" value="100" min="1" />
        </div>
        <div class="col-md-2">
          <label class="form-label">Grade <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="grade" placeholder="A, B, C..." required />
        </div>
        <div class="col-md-2">
          <label class="form-label">Exam Type <span class="text-danger">*</span></label>
          <select class="form-select" name="examType" required>
            <option value="">Select...</option>
            <option value="unit-test">Unit Test</option>
            <option value="mid-term">Mid-Term</option>
            <option value="final">Final</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Academic Year</label>
          <input type="text" class="form-control" name="academicYear" placeholder="e.g. 2023-24" />
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Result</button>
        </div>
      </div>
    </form>
  </div>
</div>
