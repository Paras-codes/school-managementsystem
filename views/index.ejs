<div class="text-center py-5">
  <h1 class="display-4 fw-bold text-primary mb-3">
    <i class="bi bi-mortarboard-fill me-2"></i>Welcome to School Management System
  </h1>
  <p class="lead text-muted mb-5">Manage students, results, and attendance all in one place.</p>
  <div class="row justify-content-center g-4">
    <div class="col-md-4">
      <div class="card shadow hover-card h-100">
        <div class="card-body text-center p-5">
          <i class="bi bi-shield-lock-fill text-danger fs-1 mb-3"></i>
          <h3 class="card-title">Admin Portal</h3>
          <p class="card-text text-muted">Manage students, record results, and track attendance.</p>
          <a href="/auth/login?role=admin" class="btn btn-danger btn-lg mt-2">
            <i class="bi bi-box-arrow-in-right me-1"></i>Admin Login
          </a>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow hover-card h-100">
        <div class="card-body text-center p-5">
          <i class="bi bi-people-fill text-success fs-1 mb-3"></i>
          <h3 class="card-title">Parent Portal</h3>
          <p class="card-text text-muted">View your child's results, attendance, and profile.</p>
          <a href="/auth/login" class="btn btn-success btn-lg mt-2">
            <i class="bi bi-box-arrow-in-right me-1"></i>Parent Login
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
