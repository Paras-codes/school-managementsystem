<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Results</h2>
    <% if (student) { %>
      <p class="text-muted mb-0">Student: <strong><%= student.name %></strong> &mdash; Roll: <span class="badge bg-secondary"><%= student.rollNumber %></span></p>
    <% } %>
  </div>
  <a href="/parent/dashboard" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Dashboard
  </a>
</div>

<div class="card shadow-sm">
  <div class="card-header bg-light fw-semibold">
    <i class="bi bi-list-ol me-2"></i>Academic Results (<%= results.length %>)
  </div>
  <div class="card-body p-0">
    <% if (results.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">No results available yet.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Subject</th>
              <th>Marks</th>
              <th>Percentage</th>
              <th>Grade</th>
              <th>Exam Type</th>
              <th>Academic Year</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach(r => { %>
              <tr>
                <td class="fw-semibold"><%= r.subject %></td>
                <td><%= r.marks %> / <%= r.totalMarks %></td>
                <td>
                  <% const pct = Math.round((r.marks / r.totalMarks) * 100); %>
                  <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:8px; min-width:60px;">
                      <div class="progress-bar <%= pct >= 75 ? 'bg-success' : pct >= 50 ? 'bg-warning' : 'bg-danger' %>"
                           style="width: <%= pct %>%"></div>
                    </div>
                    <small><%= pct %>%</small>
                  </div>
                </td>
                <td><span class="badge bg-primary"><%= r.grade %></span></td>
                <td><span class="badge bg-info text-dark"><%= r.examType %></span></td>
                <td><%= r.academicYear || '-' %></td>
                <td><%= new Date(r.createdAt).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
