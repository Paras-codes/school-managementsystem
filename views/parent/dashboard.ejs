<h2 class="mb-4"><i class="bi bi-house-heart-fill me-2 text-success"></i>Parent Dashboard</h2>

<% if (!student) { %>
  <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>No student linked to your account. Please contact the school admin.</div>
<% } else { %>
  <div class="row g-4">
    <div class="col-md-6">
      <div class="card shadow hover-card">
        <div class="card-header bg-primary text-white fw-semibold">
          <i class="bi bi-person-fill me-2"></i>Student Profile
        </div>
        <div class="card-body">
          <table class="table table-borderless mb-0">
            <tr><th class="text-muted" width="40%">Name</th><td><strong><%= student.name %></strong></td></tr>
            <tr><th class="text-muted">Roll Number</th><td><span class="badge bg-secondary fs-6"><%= student.rollNumber %></span></td></tr>
            <tr><th class="text-muted">Class</th><td><%= student.class %></td></tr>
            <tr><th class="text-muted">Section</th><td><%= student.section || '-' %></td></tr>
            <tr><th class="text-muted">Enrolled On</th><td><%= new Date(student.enrollmentDate).toLocaleDateString() %></td></tr>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow-sm mb-3">
        <div class="card-body text-center py-4">
          <i class="bi bi-bar-chart-fill text-primary fs-1 mb-2"></i>
          <h5>Academic Results</h5>
          <p class="text-muted">View your child's exam results and grades.</p>
          <a href="/parent/results" class="btn btn-primary">
            <i class="bi bi-bar-chart me-1"></i>View Results
          </a>
        </div>
      </div>
      <div class="card shadow-sm">
        <div class="card-body text-center py-4">
          <i class="bi bi-calendar-check-fill text-success fs-1 mb-2"></i>
          <h5>Attendance Records</h5>
          <p class="text-muted">Track attendance history and statistics.</p>
          <a href="/parent/attendance" class="btn btn-success">
            <i class="bi bi-calendar3 me-1"></i>View Attendance
          </a>
        </div>
      </div>
    </div>
  </div>
<% } %>
